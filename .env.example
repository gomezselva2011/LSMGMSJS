# Contraseñas de los dos perfiles admin SOLO al crear la base por primera vez.
# Si ya hay usuarios en data/gastos.sqlite, el arranque no las cambia.
# En un clone vacío sin estas variables se usan dummy locales (dev-only-local-*).
# En producción (NODE_ENV=production) son obligatorias al crear una base vacía.
GASTOS_ADMIN_PASSWORD=
GASTOS_ADMIN2_PASSWORD=

# Obligatorio en producción. Render puede generarlo (generateValue).
# No es la contraseña de login; sirve para no arrancar un deploy sin secreto.
SESSION_SECRET=

# Puerto HTTP. Vite en local usa 4731. Render/Fly inyectan PORT.
PORT=4731

# Directorio del sqlite y avatares. En Render con disco: /var/data
# (ahí debe vivir gastos.sqlite). Vacío = <cwd>/data
GASTOS_DATA_DIR=

# production = cookies Secure en HTTPS, secretos obligatorios, npm start.
NODE_ENV=
